{
  "info": {
    "name": "Game Leaderboard API",
    "description": "Run the requests from top to bottom. The Create requests save the new ids in the variables gameId, playerId and scoreId, and the other requests use them. The Delete requests at the end remove the test data again.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "gameId",
      "value": ""
    },
    {
      "key": "playerId",
      "value": ""
    },
    {
      "key": "scoreId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Games",
      "item": [
        {
          "name": "Create game",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test(\"Game is created\", function () {",
                  "    pm.expect(body.title).to.eql(\"Tetris\");",
                  "    pm.expect(body.genre).to.eql(\"Puzzle\");",
                  "});",
                  "pm.collectionVariables.set(\"gameId\", body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/games/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "games",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Tetris\",\n  \"genre\": \"Puzzle\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List games",
          "event": [
            {
